# ─── Content Service Standalone Configuration ───
# Copy this file to .env and fill in values

# Service toggle — only content module loaded
BOOT_SERVICES_CONTENT=true

# Database (PostgreSQL — required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/content_service

# Cache (optional — comment out to disable)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URL=redis://localhost:6379
# CACHE_MEMCACHED_ENABLED=true
# CACHE_MEMCACHED_HOSTS=localhost:11211

# File Storage (R2 or S3)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=content-assets
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
# For Cloudflare R2:
# STORAGE_PROVIDER=r2
# STORAGE_R2_ACCOUNT_ID=your-account-id

# Content Module
CONTENT_DEFAULT_LOCALE=en
CONTENT_LOCALES=en,vi
CONTENT_CACHE_TTL=300
CONTENT_GRAPHQL=false
CONTENT_ENABLE_SEARCH=true
CONTENT_ENABLE_WEBHOOKS=true

# RAG Semantic Search (optional — requires pgvector extension)
# RAG_ENABLED=true
# RAG_EMBEDDING_PROVIDER=openai
# RAG_API_KEY=sk-your-openai-api-key
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_EMBEDDING_DIMENSION=1536
# RAG_SIMILARITY_THRESHOLD=0.7
# RAG_CHUNK_SIZE=4000
# RAG_CHUNK_OVERLAP=200
# RAG_VECTOR_WEIGHT=0.7

# CDN Integration (optional)
# CDN_ENABLED=true
# CDN_PROVIDER=cloudflare          # cloudfront | cloudflare | custom
# CDN_CLOUDFLARE_ZONE_ID=your-zone-id
# CDN_CLOUDFLARE_API_TOKEN=your-api-token
# CDN_CLOUDFRONT_DISTRIBUTION_ID=EXXXXX
# CDN_CLOUDFRONT_ACCESS_KEY_ID=AKIAXXXXX
# CDN_CLOUDFRONT_SECRET_ACCESS_KEY=xxxxx
# CDN_DEFAULT_MAX_AGE=300          # Entry cache TTL (seconds)
# CDN_ASSET_MAX_AGE=86400          # Asset cache TTL (seconds)
# CDN_STALE_WHILE_REVALIDATE=60
# CDN_PURGE_ON_PUBLISH=true

# Delivery API
DELIVERY_API_KEY=your-delivery-api-key

# Server
PORT=3000
NODE_ENV=development
