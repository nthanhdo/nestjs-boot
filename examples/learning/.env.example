# =============================================================
# Environment variables for the learning project.
# Copy this file to .env and edit as needed.
#
#   cp .env.example .env
#
# The defaults work with the docker-compose.yml in this folder.
# =============================================================

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/learning

# Redis URL (for caching layer)
REDIS_URL=redis://localhost:6379

# Server port
PORT=3000

# JWT secret -- NEVER use this value in production!
JWT_SECRET=learning-project-secret-change-me
JWT_REFRESH_SECRET=learning-project-refresh-secret-change-me
