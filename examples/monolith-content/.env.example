# ============================================================
# monolith-content — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (required for Content Service) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monolith_content

# --- Redis (optional — enables L2 cache) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change-me-in-production

# --- Content Service ---
CONTENT_DEFAULT_LOCALE=en
CONTENT_SUPPORTED_LOCALES=en,vi
