{
  "name": "nestjs-boot",
  "version": "0.1.0",
  "description": "Spring Boot auto-configuration for NestJS — multi-database connections, reader/writer split, multi-layer cache. One config object, zero wiring.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "nestjs-boot": "./bin/create.mjs"
  },
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nestjs",
    "nest",
    "boot",
    "mongodb",
    "mongoose",
    "cache",
    "redis",
    "multi-database",
    "reader-writer",
    "infrastructure",
    "auto-configuration"
  ],
  "author": "nthanhdo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nthanhdo/nestjs-boot.git"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/microservices": "^10.0.0 || ^11.0.0",
    "@nestjs/mongoose": "^10.0.0 || ^11.0.0",
    "@nestjs/terminus": "^10.0.0 || ^11.0.0",
    "mongoose": "^7.0.0 || ^8.0.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "mongoose": {
      "optional": true
    },
    "@nestjs/mongoose": {
      "optional": true
    },
    "@nestjs/terminus": {
      "optional": true
    },
    "@nestjs/microservices": {
      "optional": true
    },
    "@grpc/grpc-js": {
      "optional": true
    },
    "@grpc/proto-loader": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "dotenv": "^16.6.1",
    "joi": "^17.0.0",
    "jsonwebtoken": "^9.0.3",
    "picocolors": "^1.1.1"
  },
  "optionalDependencies": {
    "ioredis": "^5.0.0",
    "memjs": "^1.3.0",
    "otpauth": "^9.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prom-client": "^15.0.0",
    "bullmq": "^5.0.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "ioredis": "^5.4.0",
    "ioredis-mock": "^8.9.0",
    "mongodb-memory-server": "^10.0.0",
    "mongoose": "^8.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "supertest": "^7.2.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
