{
  "name": "nestjs-boot",
  "version": "0.1.0",
  "description": "Spring Boot auto-configuration for NestJS — multi-database connections, reader/writer split, multi-layer cache. One config object, zero wiring.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["nestjs", "nest", "boot", "mongodb", "mongoose", "cache", "redis", "multi-database", "reader-writer", "infrastructure", "auto-configuration"],
  "author": "nthanhdo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nthanhdo/nestjs-boot.git"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "mongoose": "^7.0.0 || ^8.0.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "mongoose": { "optional": false }
  },
  "dependencies": {
    "joi": "^17.0.0"
  },
  "optionalDependencies": {
    "ioredis": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@nestjs/terminus": "^10.2.0",
    "mongoose": "^8.0.0",
    "ioredis": "^5.4.0",
    "ioredis-mock": "^8.9.0",
    "mongodb-memory-server": "^10.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
